# Application
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
IDENTITY_PORT=8001
CITY_CORE_PORT=8002
TRAFFIC_PROVIDER_PORT=8010
VEHICLES_PROVIDER_PORT=8011
INCIDENTS_PROVIDER_PORT=8012
WEB_PORT=3000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
IDENTITY_SERVICE_URL=http://localhost:8001
CITY_CORE_SERVICE_URL=http://localhost:8002

# PostgreSQL / PostGIS
# One Postgres instance, one database per service (see
# infrastructure/postgres/init-databases.sql): api-gateway uses POSTGRES_DB
# (cityos) below; identity and city-core each default to their own
# database (cityos_identity, cityos_city_core) baked into their own
# app/core/config.py, so there is deliberately no single shared
# DATABASE_URL here -- setting one would point every service at the same
# database and make their independent Alembic histories collide.
POSTGRES_DB=cityos
POSTGRES_USER=cityos
POSTGRES_PASSWORD=cityos_dev_only

# Redis
REDIS_URL=redis://localhost:6379/0

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=cityos_dev_only

# Qdrant (API key is optional for local development)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Kafka-compatible Redpanda
KAFKA_BROKERS=localhost:19092

# S3-compatible object storage
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=cityos
OBJECT_STORAGE_SECRET_KEY=cityos_dev_only
OBJECT_STORAGE_BUCKET=cityos-development

# Identity service: tokens, RBAC, OAuth
# Generate a real value with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
OAUTH_REDIRECT_BASE_URL=http://localhost:8000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Bootstraps the first SUPER_ADMIN account (`make bootstrap-admin`). Leave
# blank to skip; safe to clear again after the first run.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# Frontend (browser-accessible URL)
NEXT_PUBLIC_API_URL=http://localhost:8000

